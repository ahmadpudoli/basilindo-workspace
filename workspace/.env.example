APP_NAME="Basilindo Workspace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta
APP_STORAGE_TIMEZONE=UTC

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=en_US
APP_NUMBER_LOCALE=id_ID
APP_DECIMAL_SEPARATOR=,
APP_THOUSANDS_SEPARATOR=.

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database


BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# Host access to the PostgreSQL container published by docker-compose.
DB_HOST=127.0.0.1
DB_PORT=5435
DB_DATABASE=db_basilindo_workspace
DB_USERNAME=legospay
DB_PASSWORD=12345678
DB_TABLE_PREFIX=ws_
CORE_MIGRATIONS_OWNER=true
APP_MIGRATION_SET=workspace
SESSION_CONNECTION=core

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE=basilindo_workspace_session_v1
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
HRIS_DOCUMENT_DISK=s3
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=s3
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DIRECTORY=workspace-tmp
WORKSPACE_TEMPORARY_UPLOAD_TTL_HOURS=24
WORKSPACE_TEMPORARY_UPLOAD_TTL_HOURS=24
QUEUE_CONNECTION=redis
WEBPUSH_VAPID_SUBJECT=mailto:admin@example.com
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_TTL=300

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=passwordredis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=minio123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=app-workspace
STORAGE_PREFIX_DOCUMENT_MANAGEMENT=app-document-management
STORAGE_PREFIX_PROJECT_MANAGEMENT=app-project-management
STORAGE_PREFIX_CRM=app-crm
STORAGE_PREFIX_CORE=app-core
AWS_ENDPOINT=http://127.0.0.1:9005
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Development-only local recovery administrator
LOCAL_ADMIN_EMAIL=admin@example.com
LOCAL_ADMIN_PASSWORD=12345678
