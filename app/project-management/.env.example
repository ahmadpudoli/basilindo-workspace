APP_NAME="Project Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8002
SESSION_COOKIE=basilindo_project_management_session_v3
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# Host access to the PostgreSQL container published by docker-compose.
DB_HOST=127.0.0.1
DB_PORT=5437
DB_DATABASE=db_basilindo_workspace
DB_USERNAME=legospay
DB_PASSWORD=12345678
DB_TABLE_PREFIX=pm_
CORE_MIGRATIONS_OWNER=false
APP_MIGRATION_SET=project-management
SESSION_CONNECTION=core

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=passwordredis
REDIS_PORT=6381
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=minio123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=qlima-portal
AWS_ENDPOINT=http://127.0.0.1:9009
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

SSO_ENABLED=false
SSO_ISSUER_URL=http://localhost:8000
SSO_CLIENT_ID=2b3ce7c4-1c8b-4d24-9e43-6f1a7e9f5c10
SSO_CLIENT_SECRET=pm-local-client-secret-2026
SSO_REDIRECT_URI="${APP_URL}/auth/sso/callback"
SSO_ALLOW_SYSTEM_ACCOUNT_LINKING=false
