APP_NAME="Basilindo Document Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# Host access to the PostgreSQL container published by docker-compose.
DB_HOST=127.0.0.1
DB_PORT=5435
DB_DATABASE=db_basilindo_workspace
DB_USERNAME=legospay
DB_PASSWORD=12345678
DB_TABLE_PREFIX=fo_
CORE_MIGRATIONS_OWNER=true
APP_MIGRATION_SET=file-organizer
SESSION_CONNECTION=core

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE=basilindo_file_organizer_session
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=passwordredis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=minio123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=app-file-organize
AWS_ENDPOINT=http://127.0.0.1:9005
AWS_USE_PATH_STYLE_ENDPOINT=true

# Internal SSO client configuration (project-sso)
SSO_ENABLED=false
SSO_ISSUER_URL=http://127.0.0.1:8001
SSO_CLIENT_ID=file-organizer
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI="${APP_URL}/auth/sso/callback"
SSO_ALLOW_SYSTEM_ACCOUNT_LINKING=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Development-only local recovery administrator
LOCAL_ADMIN_EMAIL=admin@example.com
LOCAL_ADMIN_PASSWORD=change-me-before-use
